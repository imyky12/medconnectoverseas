# =============================================
# MedConnect Overseas — Environment Variables
# =============================================
# Copy this file to .env and fill in the values

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/medconnect

# JWT Secrets (generate strong random strings)
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OTP
OTP_EXPIRY_MINUTES=5

# Email — ZeptoMail
# Leave MAIL_ENABLED=false in development: emails are still rendered and written
# to the EmailLog collection (status: 'skipped'), they just never leave the box.
MAIL_ENABLED=false
# Zoho India accounts use api.zeptomail.in — others use .com.
# Confirm the host on the ZeptoMail dashboard under SMTP/API.
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_TOKEN=
MAIL_FROM_ADDRESS=noreply@medconnectsoverseas.com
MAIL_FROM_NAME=MedConnect Overseas
MAIL_REPLY_TO=support@medconnectsoverseas.com
# Comma-separated inboxes that receive the admin-* templates
MAIL_ADMIN_RECIPIENTS=
MAIL_MAX_ATTEMPTS=5

# SMS (placeholder — configure when provider is chosen)
SMS_API_KEY=
SMS_API_SECRET=

# Admin
ADMIN_SESSION_TIMEOUT_MINUTES=30

# CORS
CORS_ORIGIN=http://localhost:5174

# Public site origin used to build absolute links inside emails
APP_BASE_URL=https://medconnectsoverseas.com

# Referral reward issued to the referrer when their referral first buys
REFERRAL_REWARD_AMOUNT=200
REFERRAL_REWARD_VALIDITY_DAYS=90
